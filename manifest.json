{
  "manifest_version": 3,
  "name": "X Tweet Cleaner - 按关键字批量删推",
  "version": "1.2.1",
  "description": "在 X/Twitter 页面上按关键字批量删除自己的推文，支持删除间隔、批次暂停；批量查询账号精确粉丝数。",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "X Tweet Cleaner"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
